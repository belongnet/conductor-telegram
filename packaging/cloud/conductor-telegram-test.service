[Unit]
Description=Isolated Conductor Telegram acceptance gateway on OVH
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# Configure a separate test bot and HTTPS test origin before starting this unit.
EnvironmentFile=/etc/conductor-telegram/test-release.env
ExecStart=/usr/bin/docker run --rm --name conductor-telegram-test --pull never --init --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 256 --memory 2g --cpus 2 --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --tmpfs /tmp:rw,noexec,nosuid,size=512m --env-file /etc/conductor-telegram/test.env --mount type=bind,src=/var/lib/conductor-telegram-test,dst=/var/lib/conductor-telegram --publish 127.0.0.1:8788:8787 ${GATEWAY_IMAGE}
ExecStop=/usr/bin/docker stop --time 45 conductor-telegram-test
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
SyslogIdentifier=conductor-telegram-test

[Install]
WantedBy=multi-user.target
