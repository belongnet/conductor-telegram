# Store the real file at /etc/conductor-telegram/gateway.env, root:root mode 0600.
BOT_TOKEN=
OWNER_CHAT_ID=
OWNER_USER_ID=
CONDUCTOR_API_KEY=
GH_TOKEN=
TELEGRAM_BRIDGE_PUBLIC_URL=https://YOUR_APPROVED_BRIDGE_HOST
TELEGRAM_CLOUD_ROUTER_PROJECT_ID=
TELEGRAM_DEFAULT_AGENT_TYPE=claude
TELEGRAM_DEFAULT_MODEL=fable-5-1
# Only list providers with configured Conductor credentials; primary must be included.
TELEGRAM_CLOUD_PROVIDERS=claude,codex,cursor


# Optional reviewer override; choose an enabled provider different from the task author.
# TELEGRAM_REVIEW_AGENT_TYPE=codex
# TELEGRAM_REVIEW_MODEL=gpt-5.6-sol

# Optional: continuously mirror existing cloud workspaces into this forum group.
# Requires OWNER_USER_ID and the bot's Manage Topics administrator permission.
# TELEGRAM_CLOUD_SYNC_CHAT_ID=-1000000000000
# During coexistence with an old bot, require explicitly addressed commands.
# TELEGRAM_CLOUD_SYNC_INPUT=commands
