{
  "intervalMinutes": 30,
  "providers": {
    "primary": {
      "agent": "claude",
      "model": "claude-example-model",
      "effort": "high",
      "gapHours": 4.5,
      "maxActive": 1,
      "maxNudges": 8
    },
    "secondary": {
      "agent": "codex",
      "model": "codex-example-model",
      "effort": "high",
      "gapHours": 4.5,
      "maxActive": 1,
      "maxNudges": 8
    },
    "cursor": {
      "agent": "cursor",
      "model": "cursor-example-model",
      "effort": "high",
      "gapHours": 4.5,
      "maxActive": 1,
      "maxNudges": 8
    },
    "validator": {
      "agent": "codex",
      "model": "validation-example-model",
      "effort": "high",
      "gapHours": 4.5,
      "maxActive": 1,
      "maxNudges": 8
    }
  },
  "lanes": [
    {
      "id": "L1",
      "title": "Example first lane",
      "provider": "primary",
      "repoUrl": "https://github.com/example-org/example-repo",
      "prompt": "prompts/l1.md",
      "after": [],
      "delivery": {
        "review": {
          "rotation": ["secondary", "cursor", "validator"],
          "prompt": "prompts/review.md"
        },
        "finals": {
          "rotation": ["secondary", "cursor", "validator"],
          "prompt": "prompts/final.md"
        },
        "merge": {
          "rotation": ["validator", "secondary", "cursor"],
          "prompt": "prompts/merge.md",
          "method": "squash",
          "deployNotes": "No automatic deploy is configured.",
          "replayNotes": "No replay is required."
        },
        "validation": {
          "rotation": ["validator", "cursor", "secondary"],
          "prompt": "prompts/validation.md",
          "verification": "npm test && npm run typecheck"
        }
      }
    },
    {
      "id": "L2",
      "title": "Example second lane",
      "provider": "any",
      "repoUrl": "https://github.com/example-org/example-repo",
      "prompt": "prompts/l2.md",
      "after": ["L1"]
    }
  ]
}
